# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bunny CDN (media storage)
BUNNY_API_KEY=your-bunny-api-key
BUNNY_STORAGE_ZONE=sdcrsystems
BUNNY_REGION=syd
BUNNY_CDN_URL=https://sdcrsystems.b-cdn.net

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# App URL (required in production — used for report links in emails)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Business phone shown on the public report and in customer emails.
# Must match what is published on samedaycarrepair.com.au.
NEXT_PUBLIC_BUSINESS_PHONE=0424 225 942

# Google review link shown at the bottom of the public report.
# Get it from Google Business Profile -> Ask for reviews. Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/YOUR_PLACE_ID/review
